PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Admin account used by the JWT authentication layer.
# ADMIN_PASSWORD is hashed with bcrypt at startup and never exposed to the frontend.
ADMIN_EMAIL=admin@netguard.com
ADMIN_PASSWORD=change-me

# Generate a strong random secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit the real value. Never use this placeholder in production.
JWT_SECRET=replace-with-a-long-random-secret
